{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracking.schema.json",
  "title": "追蹤名單：每次執行都觀測這些專案的星數",
  "type": "object",
  "required": ["schema_version", "updated_at", "repos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "updated_at": {"type": "string"},
    "repos": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["repo_id", "full_name", "first_seen", "last_seen"],
        "additionalProperties": false,
        "properties": {
          "repo_id": {"type": "integer", "minimum": 1},
          "full_name": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
          "first_seen": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "last_seen": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "最後一次出現在 Trending 或 Search 的台北日期"}
        }
      }
    }
  }
}
