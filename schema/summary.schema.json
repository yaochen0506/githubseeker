{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary.schema.json",
  "title": "模型產生的繁體中文摘要（也用來要求模型照格式輸出）",
  "type": "object",
  "required": ["one_liner", "features", "audience", "use_cases", "barrier", "barrier_note", "limitations", "based_on"],
  "additionalProperties": false,
  "properties": {
    "one_liner": {"type": "string", "minLength": 4, "maxLength": 60},
    "features": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 2, "maxLength": 40}},
    "audience": {"type": "string", "minLength": 2, "maxLength": 60},
    "use_cases": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 2, "maxLength": 60}},
    "barrier": {"enum": ["online", "install", "code"]},
    "barrier_note": {"type": "string", "minLength": 2, "maxLength": 60},
    "limitations": {"type": "string", "minLength": 2, "maxLength": 80},
    "based_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["description", "readme", "topics"]}}
  }
}
