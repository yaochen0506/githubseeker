{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edition.schema.json",
  "title": "每日精選（提交後不再修改）",
  "type": "object",
  "required": [
    "schema_version",
    "score_version",
    "edition_id",
    "business_date",
    "generated_at",
    "run_id",
    "status",
    "coverage",
    "picks",
    "cooldown_excluded",
    "candidate_counts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "score_version": {
      "type": "string"
    },
    "edition_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "description": "精選產生的時間，也是 RSS 的發布時間"
    },
    "run_id": {
      "type": "string",
      "description": "精選所依據的那一次收集"
    },
    "status": {
      "enum": [
        "normal",
        "degraded"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "sources_ok",
        "sources_failed"
      ],
      "additionalProperties": false,
      "properties": {
        "sources_ok": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "picks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/pick"
      }
    },
    "cooldown_excluded": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "因 7 天內入選過而排除的專案"
    },
    "candidate_counts": {
      "type": "object",
      "required": [
        "main",
        "discovery"
      ],
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "integer",
          "minimum": 0
        },
        "discovery": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary_stats": {
      "type": "object",
      "description": "C 階段：這份精選的摘要統計",
      "required": [
        "enabled",
        "reason",
        "model",
        "attempted",
        "done",
        "failed",
        "skipped",
        "cached",
        "calls",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "依 API 價格換算的參考值；使用訂閱權杖時不會實際扣款"
        }
      }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "required": [
        "slot",
        "position",
        "repo_id",
        "full_name",
        "html_url",
        "description",
        "language",
        "topics",
        "license_spdx",
        "created_at",
        "pushed_at",
        "stars",
        "forks",
        "metric_method",
        "growth_per_day",
        "score",
        "score_breakdown",
        "trending_hits",
        "reasons",
        "notes",
        "repeat_of"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "enum": [
            "main",
            "discovery"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "repo_id": {
          "type": "integer",
          "minimum": 1
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "html_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license_spdx": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "pushed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "forks": {
          "type": "integer",
          "minimum": 0
        },
        "metric_method": {
          "enum": [
            "trending_daily",
            "trending_weekly_avg",
            "lifetime_avg"
          ]
        },
        "growth_per_day": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "score_breakdown": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "s_abs",
                "s_rel"
              ],
              "additionalProperties": false,
              "properties": {
                "s_abs": {
                  "type": "number"
                },
                "s_rel": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "trending_hits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "rank",
              "period",
              "period_stars"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "period": {
                "enum": [
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "period_stars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repeat_of": {
          "type": [
            "string",
            "null"
          ],
          "description": "D 階段的「再次推薦」用；B 階段一律為 null"
        },
        "summary": {
          "type": "object",
          "description": "C 階段：繁體中文摘要（選填，B 階段的精選沒有這個欄位）",
          "required": [
            "status",
            "content",
            "model",
            "prompt_version",
            "cache_key",
            "has_readme",
            "from_cache",
            "attempts",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "done",
                "failed",
                "skipped"
              ]
            },
            "content": {
              "anyOf": [
                {
                  "$ref": "summary.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "cache_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "has_readme": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "from_cache": {
              "type": "boolean"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
