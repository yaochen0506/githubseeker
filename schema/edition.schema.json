{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edition.schema.json",
  "title": "每日精選（提交後不再修改）",
  "type": "object",
  "required": ["schema_version", "score_version", "edition_id", "business_date", "generated_at", "run_id", "status", "coverage", "picks", "cooldown_excluded", "candidate_counts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "score_version": {"type": "string"},
    "edition_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "business_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_at": {"type": "string", "description": "精選產生的時間，也是 RSS 的發布時間"},
    "run_id": {"type": "string", "description": "精選所依據的那一次收集"},
    "status": {"enum": ["normal", "degraded"]},
    "coverage": {
      "type": "object",
      "required": ["sources_ok", "sources_failed"],
      "additionalProperties": false,
      "properties": {
        "sources_ok": {"type": "array", "items": {"type": "string"}},
        "sources_failed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "picks": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/pick"}},
    "cooldown_excluded": {"type": "array", "items": {"type": "integer"}, "description": "因 7 天內入選過而排除的專案"},
    "candidate_counts": {
      "type": "object",
      "required": ["main", "discovery"],
      "additionalProperties": false,
      "properties": {
        "main": {"type": "integer", "minimum": 0},
        "discovery": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "required": ["slot", "position", "repo_id", "full_name", "html_url", "description", "language", "topics", "license_spdx", "created_at", "pushed_at", "stars", "forks", "metric_method", "growth_per_day", "score", "score_breakdown", "trending_hits", "reasons", "notes", "repeat_of"],
      "additionalProperties": false,
      "properties": {
        "slot": {"enum": ["main", "discovery"]},
        "position": {"type": "integer", "minimum": 1},
        "repo_id": {"type": "integer", "minimum": 1},
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
        "html_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
        "description": {"type": ["string", "null"], "maxLength": 500},
        "language": {"type": ["string", "null"]},
        "topics": {"type": "array", "items": {"type": "string"}},
        "license_spdx": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]},
        "pushed_at": {"type": ["string", "null"]},
        "stars": {"type": "integer", "minimum": 0},
        "forks": {"type": "integer", "minimum": 0},
        "metric_method": {"enum": ["trending_daily", "trending_weekly_avg", "lifetime_avg"]},
        "growth_per_day": {"type": "number", "minimum": 0},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_breakdown": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["s_abs", "s_rel"],
              "additionalProperties": false,
              "properties": {"s_abs": {"type": "number"}, "s_rel": {"type": "number"}}
            }
          ]
        },
        "trending_hits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "rank", "period", "period_stars"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string"},
              "rank": {"type": "integer", "minimum": 1},
              "period": {"enum": ["daily", "weekly", "monthly"]},
              "period_stars": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        },
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "repeat_of": {"type": ["string", "null"], "description": "D 階段的「再次推薦」用；B 階段一律為 null"}
      }
    }
  }
}
