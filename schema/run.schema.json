{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "一次收集執行的完整紀錄（只新增、不修改）",
  "type": "object",
  "required": ["schema_version", "run_id", "business_date", "started_at", "finished_at", "trigger", "code_version", "config_sha256", "complete", "sources", "source_hits", "observations", "unresolved", "api_usage"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}-[A-Za-z0-9.-]+$"},
    "business_date": {"$ref": "#/$defs/date", "description": "台北日期"},
    "started_at": {"$ref": "#/$defs/datetime"},
    "finished_at": {"$ref": "#/$defs/datetime"},
    "trigger": {
      "type": "object",
      "required": ["event", "schedule", "scheduled_for", "delay_minutes"],
      "additionalProperties": false,
      "properties": {
        "event": {"type": "string"},
        "schedule": {"type": ["string", "null"], "description": "觸發的 cron 字串"},
        "scheduled_for": {"anyOf": [{"$ref": "#/$defs/datetime"}, {"type": "null"}]},
        "delay_minutes": {"type": ["number", "null"]}
      }
    },
    "code_version": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "complete": {"type": "boolean", "description": "所有來源都成功、且沒有因配額跳過任何專案"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "source_hits": {"type": "array", "items": {"$ref": "#/$defs/hit"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "api_usage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/usage"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$"},
    "repo_id": {"type": "integer", "minimum": 1},
    "full_name": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
    "source": {
      "type": "object",
      "required": ["source_id", "kind", "url", "status", "error"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string"},
        "kind": {"enum": ["trending", "search"]},
        "url": {"type": "string"},
        "period": {"enum": ["daily", "weekly", "monthly"]},
        "query": {"type": "string"},
        "status": {"enum": ["ok", "failed"]},
        "http_status": {"type": ["integer", "null"]},
        "rows": {"type": "integer", "minimum": 0},
        "total_count": {"type": ["integer", "null"]},
        "incomplete_results": {"type": ["boolean", "null"]},
        "error": {"type": ["string", "null"]}
      }
    },
    "hit": {
      "type": "object",
      "required": ["source_id", "rank", "repo_id", "full_name", "period_stars"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string"},
        "rank": {"type": "integer", "minimum": 1},
        "repo_id": {"anyOf": [{"$ref": "#/$defs/repo_id"}, {"type": "null"}]},
        "full_name": {"$ref": "#/$defs/full_name"},
        "period_stars": {"type": ["integer", "null"], "minimum": 0, "description": "Trending 頁面顯示的期間新增星數；缺失為 null，真的是 0 才存 0；Search 一律為 null"},
        "page_stars": {"type": ["integer", "null"], "minimum": 0, "description": "Trending 頁面顯示的總星數，只供對照，不用來計算成長"}
      }
    },
    "observation": {
      "type": "object",
      "required": ["repo_id", "full_name", "observed_at", "stars", "forks", "stars_source", "origins"],
      "additionalProperties": false,
      "properties": {
        "repo_id": {"$ref": "#/$defs/repo_id"},
        "full_name": {"$ref": "#/$defs/full_name"},
        "observed_at": {"$ref": "#/$defs/datetime"},
        "stars": {"type": "integer", "minimum": 0},
        "forks": {"type": "integer", "minimum": 0},
        "open_issues": {"type": ["integer", "null"], "minimum": 0},
        "stars_source": {"enum": ["repo_api", "search_api"], "description": "成長計算時只比較同一種來源的數字"},
        "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["trending", "search", "tracking"]}},
        "description": {"type": ["string", "null"], "maxLength": 500},
        "language": {"type": ["string", "null"]},
        "topics": {"type": "array", "items": {"type": "string"}},
        "license_spdx": {"type": ["string", "null"]},
        "homepage": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]},
        "pushed_at": {"type": ["string", "null"]},
        "archived": {"type": ["boolean", "null"]},
        "fork": {"type": ["boolean", "null"]},
        "renamed_from": {"anyOf": [{"$ref": "#/$defs/full_name"}, {"type": "null"}]}
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["repo_id", "full_name", "reason"],
      "additionalProperties": false,
      "properties": {
        "repo_id": {"anyOf": [{"$ref": "#/$defs/repo_id"}, {"type": "null"}]},
        "full_name": {"anyOf": [{"$ref": "#/$defs/full_name"}, {"type": "null"}]},
        "reason": {"enum": ["not_found", "rate_limited", "budget_exhausted", "error"]},
        "detail": {"type": ["string", "null"]}
      }
    },
    "usage": {
      "type": "object",
      "required": ["requests"],
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "limit": {"type": ["integer", "null"]},
        "remaining_first": {"type": ["integer", "null"]},
        "remaining_last": {"type": ["integer", "null"]},
        "used_by_headers": {"type": ["integer", "null"], "description": "由 x-ratelimit-remaining 前後差值算出；中途重置配額時為 null"}
      }
    }
  }
}
